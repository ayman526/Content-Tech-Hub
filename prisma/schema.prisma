// ─── OCR Requests (Localization Asset) ──────────────────────────────────────

enum OcrRequestStatus {
  NEEDS_VERIFICATION
  IN_REVIEW
  VERIFIED
  READY
  FAILED
}

model OcrRequest {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccountId   String?
  clientAccount     ClientAccount?   @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  createdById       String
  // Friendly display name (defaults to filename when not provided)
  name              String?

  sourceFilename    String
  sourceFileUrl     String           // path to persisted scanned PDF / image
  sourceMimeType    String?          // application/pdf, image/jpeg, image/png, image/webp
  sourceLanguage    String?          // detected language
  pageCount         Int              @default(0)
  wordCount         Int              @default(0)

  status            OcrRequestStatus @default(NEEDS_VERIFICATION)
  workflowType      OcrWorkflowType  @default(AI_ONLY)
  provider          String           @default("tesseract")    // tesseract | mistral | mistral+tesseract
  avgConfidence     Decimal          @db.Decimal(5, 4)        // 0.0000 – 1.0000
  perPageConfidence Float[]          @default([])             // parallel array of per-page conf (0..1)
  pages             Json             @default("[]")           // OcrPage[] per-page text/conf/blocks
  extractedText     String?          // joined text across all pages
  extractedMarkdown String?          // Mistral markdown when available
  structuredLayout  Json?            // bounding-box layout for delivery overlay

  // Linguist verification (AI + Human Review workflow)
  linguistJobId     String?          // backing Job id when human review requested
  verifiedText      String?          // corrected text submitted by linguist

  assignedLinguistId String?
  notes              String?
  verifiedAt         DateTime?
  verifiedById       String?

  // Optional link to project created from this OCR (after verification)
  linkedProjectId    String?
  linkedProject      Project?        @relation("ProjectOcrRequests", fields: [linkedProjectId], references: [id], onDelete: SetNull)
  // Reverse side of Project.attachedOcrRequestId (a single project may be
  // anchored back to its source OCR request)
  attachedToProjects Project[]       @relation("ProjectAttachedOcrRequest")

  // Credits charged when the request was created (per-page rate)
  creditsCharged     Int             @default(0)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, clientAccountId])
}

enum OcrWorkflowType {
  AI_ONLY
  AI_HUMAN
}

model ImpersonationToken {
  id           String    @id @default(cuid())
  token        String    @unique @default(cuid())
  adminId      String
  targetUserId String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  admin        User      @relation("AdminImpersonations", fields: [adminId], references: [id])
  targetUser   User      @relation("ImpersonationTargets", fields: [targetUserId], references: [id])
}
