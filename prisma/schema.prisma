  callCount        Int       @default(1)
  kind             String    @default("chat_completion")

  @@index([createdAt])
  @@index([modelId, createdAt])
  @@index([jobId])
  @@index([organizationId, createdAt])
  @@index([billingMode, createdAt])
}

model LlmRoutingRule {
