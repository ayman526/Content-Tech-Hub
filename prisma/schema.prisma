// ─── LLM Routing & Provider Configuration ───────────────────────────────────

model AiProvider {
  id           String   @id @default(cuid())
  name         String
  type         String   // openai | anthropic | google | azure | vertex | bedrock | cohere | moonshot | custom
  baseUrl      String?
  region       String?
  environment  String   @default("production") // dev | staging | production
  status       String   @default("active")     // active | inactive
  rateLimitRpm Int?
  costProfile  String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  secret       ProviderSecret?
  models       AiModel[]
  healthChecks LlmHealthCheck[]
}

model ProviderSecret {
  id           String     @id @default(cuid())
  providerId   String     @unique
  provider     AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  encryptedKey String
  keyMasked    String
  orgProjectId String?
  rotatedAt    DateTime   @default(now())
  updatedBy    String?
}

model AiModel {
  id             String     @id @default(cuid())
  providerId     String
  provider       AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  displayName    String
  apiModelId     String
  internalKey    String     @unique
  version        String?
  contextWindow  Int?
  outputLimit    Int?
  status         String     @default("draft") // draft|beta|approved|production|deprecated|retired|disabled
  latencyTier    String     @default("balanced")   // fast|balanced|high-quality
  costTier       String     @default("medium")     // low|medium|premium
  qualityTier    String     @default("standard")   // standard|advanced|flagship
  capabilities   Json       @default("{}")
  domains        String[]   @default([])
  languageGroups String[]   @default([])
  warnings       String[]   @default([])
  benchmarkNotes          String?
  effectiveFrom           DateTime?
  deprecatedAt            DateTime?
  retiredAt               DateTime?
  isDefault               Boolean    @default(false)
  notes                   String?
  costPerInputTokenUsd    Decimal?   @db.Decimal(14, 10)
  costPerOutputTokenUsd   Decimal?   @db.Decimal(14, 10)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  primaryRules   LlmRoutingRule[] @relation("PrimaryModel")
  secondaryRules LlmRoutingRule[] @relation("SecondaryModel")
  tertiaryRules  LlmRoutingRule[] @relation("TertiaryModel")
  healthChecks   LlmHealthCheck[]
  usageEvents    LlmUsageEvent[]
}

model LlmUsageEvent {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  organizationId   String?
  projectId        String?
  jobId            String?
  segmentId        String?
