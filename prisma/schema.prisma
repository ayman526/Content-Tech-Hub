generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String?
  role          Role      @default(CLIENT)
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  organizationId   String?
  organization     Organization?  @relation(fields: [organizationId], references: [id])

  linguistProfile  LinguistProfile?

  clientProjects    Project[]        @relation("ClientProjects")
  assignments       Job[]            @relation("LinguistJobs")
  favoriteLinguists FavoriteLinguist[] @relation("ClientFavorites")
  favoritedBy       FavoriteLinguist[] @relation("FavoritedLinguist")
  apiConfigs        ApiConfiguration[]
  notifications     Notification[]
  segmentsAssigned  TranslationSegment[] @relation("AssignedLinguist")
  segmentsReviewed  TranslationSegment[] @relation("ReviewedBy")
  segmentComments   SegmentComment[]     @relation("CommentAuthor")
  joinRequests      OrganizationJoinRequest[]
  reviewsGiven      LinguistReview[]  @relation("ReviewsGiven")
  reviewsReceived   LinguistReview[]  @relation("ReviewsReceived")
  blacklistOwner    LinguistBlacklist[] @relation("BlacklistOwner")
  blacklisted       LinguistBlacklist[] @relation("Blacklisted")
  departmentMemberships DepartmentMember[]
  invitationsSent   DepartmentInvitation[] @relation("InvitesSent")
  issuesLogged      SegmentIssue[]         @relation("IssuesLogged")
  linguistInvitesSent     LinguistInvitation[]   @relation("LinguistInvitesSent")
  linguistInvitesAccepted LinguistInvitation[]   @relation("LinguistInvitesAccepted")
  clientAccountAccess     MemberClientAccountAccess[]
  inAppNotifications      InAppNotification[]
  notificationPreferences UserNotificationPreference[]
  authoredResources       ResourceArticle[]            @relation("AuthoredResources")
  studioWorkspace         StudioWorkspace?

  impersonationTokensIssued   ImpersonationToken[] @relation("AdminImpersonations")
  impersonationTokensReceived ImpersonationToken[] @relation("ImpersonationTargets")
}

enum Role {
  CLIENT
  LINGUIST
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  plan                   Plan     @default(STARTER)
  creditBalance          Int      @default(0)
  // Business context — fed into AI translation prompts to improve draft quality
  websiteUrl             String?
  industry               String?
  companyBio             String?
  // Monthly credit cycle
  creditsResetAt         DateTime?
  // Stripe billing
  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  users               User[]
  projects            Project[]
  translationMemories TranslationMemory[]
  glossaries          Glossary[]
  styleGuides         StyleGuide[]
  creditTransactions  CreditTransaction[]
  favoriteLinguists   FavoriteLinguist[]
  joinRequests        OrganizationJoinRequest[]
  departments          Department[]
  linguistBlacklists   LinguistBlacklist[]
  departmentInvitations DepartmentInvitation[]
  linguistInvitations   LinguistInvitation[]
  contentfulConnection  ContentfulConnection?
  contentfulMappings    ContentfulMapping[]
  contentfulJobs        ContentfulJob[]
  apiKeys               ApiKey[]
  webhookSubscriptions  WebhookSubscription[]
  clientAccounts        ClientAccount[]
  memberClientAccountAccess MemberClientAccountAccess[]
  wordpressConnection   WordpressConnection?
  wordpressMappings     WordpressMapping[]
  wordpressJobs         WordpressJob[]
  ocrRequests           OcrRequest[]
}

model ClientAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  notes          String?
  // Business context for this end-client — fed into AI translation prompts
  websiteUrl     String?
  industry       String?
  companyBio     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  translationMemories      TranslationMemory[]
  glossaries               Glossary[]
  styleGuides              StyleGuide[]
  projects                 Project[]
  memberAccessAssignments  MemberClientAccountAccess[]
  ocrRequests              OcrRequest[]
}

model MemberClientAccountAccess {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccountId String
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([userId, clientAccountId])
}

enum Plan {
  STARTER
  PROFESSIONAL
  AGENCY
  ENTERPRISE
}

model LinguistProfile {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String?
  bio              String?
  linguistType     LinguistType @default(SYSTEM)
  isActive         Boolean      @default(true)
  languagePairs    Json         @default("[]")
  specializations  String[]
  hourlyRate       Decimal?     @db.Decimal(10, 2)
  certifications   String[]
  cvUrl            String?
  isVerified       Boolean      @default(false)
  rating           Decimal      @default(0) @db.Decimal(3, 2)
  reviewCount      Int          @default(0)
  completedJobs    Int          @default(0)
  acceptanceRate   Decimal      @default(0) @db.Decimal(5, 2)
  availableFrom    DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  languagePairsStructured LinguistLanguagePair[]
}

model Project {
  id              String        @id @default(cuid())
  name            String
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  clientId        String
  client          User          @relation("ClientProjects", fields: [clientId], references: [id])
  clientAccountId  String?
  clientAccount    ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  status          ProjectStatus @default(DRAFT)
  workflowType    WorkflowType  @default(AI_HUMAN)
  sourceLanguage  String
  targetLanguages String[]
  totalWordCount  Int           @default(0)
  dueDate            DateTime?
  notes              String?
  attachedTmIds      String[]   @default([])
  attachedGlossaryIds String[]  @default([])
  attachedStyleGuideIds String[] @default([])
  // Optional source OCR request whose verified text drove this project.
  // Set when a user clicks "Use in new translation project" from an
  // OcrRequest detail page; used by the delivery pipeline to look up
  // bounding-box layout for high-fidelity translated output.
  attachedOcrRequestId String?
  attachedOcrRequest   OcrRequest? @relation("ProjectAttachedOcrRequest", fields: [attachedOcrRequestId], references: [id], onDelete: SetNull)
  ocrConfidenceWarning Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  documents          Document[]
  jobs               Job[]
  creditTransactions CreditTransaction[]
  ocrRequests        OcrRequest[]    @relation("ProjectOcrRequests")
}

enum ProjectStatus {
  DRAFT
  PENDING
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum WorkflowType {
  BYOK
  CREDITS
  HUMAN_ONLY
  AI_HUMAN
}

model Document {
  id                  String          @id @default(cuid())
  projectId           String
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalFilename    String
  originalFileUrl     String
  translatedFileUrl   String?
  fileType            String
  wordCount           Int             @default(0)
  processingStatus    ProcessingStatus @default(PENDING)
  detectedLanguage    String?
  detectedDocType     String?
  layoutHtml          String?
  structuredData      Json?
  createdAt           DateTime        @default(now())

  segments            TranslationSegment[]
}

enum ProcessingStatus {
  PENDING
  ANALYZING
  TRANSLATING
  REVIEW
  COMPLETED
  FAILED
}

model TranslationSegment {
  id                 String   @id @default(cuid())
  documentId         String
  document           Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  segmentIndex       Int
  sourceText         String
  translatedText     String?
  formatHint         String   @default("p")
  status             SegmentStatus @default(PENDING)
  assignedLinguistId String?
  assignedLinguist   User?    @relation("AssignedLinguist", fields: [assignedLinguistId], references: [id])
  reviewedById       String?
  reviewedBy         User?    @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  createdAt          DateTime @default(now())

  // ── Typography & geometry from pdf-processor microservice ─────────────────
  // All fields are nullable so existing segments created before this migration
  // are unaffected. New segments created via extractPdf() will populate them.
  blockId            String?   // blockId returned by /extract
  blockType          String?   // paragraph | heading | table-cell | caption | header | footer
  fontFamily         String?
  fontSize           Float?
  fontWeight         String?   // normal | bold
  fontColor          String?   // #RRGGBB
  textAlignment      String?   // left | center | right | justify
  lineHeight         Float?
  bboxJson           Json?     // { x, y, width, height } in PDF points
  direction          String?   // ltr | rtl
  columnIndex        Int?
  readingOrder       Int?
  tableId            String?   // set when blockType = "table-cell"
  tableRow           Int?
  tableCol           Int?
  blockPage          Int?      // 0-based page number from the extractor

  @@unique([documentId, segmentIndex])
  comments           SegmentComment[]
  issues             SegmentIssue[]
  jobTranslations    JobTranslation[]
}

model SegmentComment {
  id          String   @id @default(cuid())
  segmentId   String
  segment     TranslationSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("CommentAuthor", fields: [authorId], references: [id])
  text        String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

enum SegmentStatus {
  PENDING
  IN_PROGRESS
  TRANSLATED
  REVIEWED
  APPROVED
}

model Job {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id])
  linguistId      String?
  linguist        User?          @relation("LinguistJobs", fields: [linguistId], references: [id])
  status          JobStatus      @default(AVAILABLE)
  linguistSource  LinguistSource @default(SYSTEM_POOL)
  exclusiveUntil  DateTime?
  sourceLanguage  String
  targetLanguage  String
  wordCount       Int
  payoutAmount    Decimal?       @db.Decimal(10, 2)
  businessShare   Decimal?       @db.Decimal(10, 2)
  breakdownJSON   Json?
  acceptedAt      DateTime?
  completedAt     DateTime?
  auditReportUrl  String?
  createdAt       DateTime       @default(now())

  routingLogs       RoutingLog[]
  review            LinguistReview?
  segmentIssues     SegmentIssue[]
  jobTranslations   JobTranslation[]
}

model JobTranslation {
  id             String             @id @default(cuid())
  jobId          String
  job            Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  segmentId      String
  segment        TranslationSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  translatedText String

  @@unique([jobId, segmentId])
}

model SegmentIssue {
  id          String          @id @default(cuid())
  segmentId   String
  segment     TranslationSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewerId  String?
  reviewer    User?           @relation("IssuesLogged", fields: [reviewerId], references: [id])
  category    IssueCategory
  subType     String
  severity    IssueSeverity
  note        String?
  source      String          @default("human")
  createdAt   DateTime        @default(now())
}

enum IssueCategory {
  ACCURACY
  TERMINOLOGY
  GRAMMAR
  STYLE_TONE
  LOCALE
  FORMATTING_TAGS
  CONSISTENCY
  COMPLIANCE
}

enum IssueSeverity {
  LOW
  MEDIUM
  CRITICAL
}

enum JobStatus {
  AVAILABLE
  EXCLUSIVE
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  APPROVED
  CANCELLED
}

model FavoriteLinguist {
  id             String       @id @default(cuid())
  customerId     String
  customer       User         @relation("ClientFavorites", fields: [customerId], references: [id])
  linguistId     String
  linguist       User         @relation("FavoritedLinguist", fields: [linguistId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  notes          String?
  createdAt      DateTime     @default(now())

  @@unique([customerId, linguistId])
}

model StyleGuide {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccountId  String?
  clientAccount    ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  name             String
  fileName         String
  mimeType         String
  content          String         @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model TranslationMemory {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  clientAccountId String?
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  name            String
  sourceLanguage  String
  targetLanguage  String
  entryCount      Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  entries        TmEntry[]
}

model TmEntry {
  id           String            @id @default(cuid())
  tmId         String
  tm           TranslationMemory @relation(fields: [tmId], references: [id], onDelete: Cascade)
  sourceText   String
  targetText   String
  context      String?
  createdBy    String            @default("human")
  confidence   Decimal           @default(1.0) @db.Decimal(5, 2)
  usageCount   Int               @default(0)
  lastUsed     DateTime?
  createdAt    DateTime          @default(now())

  @@unique([tmId, sourceText])
}

model Glossary {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  clientAccountId String?
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  name            String
  languages       String[]
  termCount       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  terms          GlossaryTerm[]
}

model GlossaryTerm {
  id             String   @id @default(cuid())
  glossaryId     String
  glossary       Glossary @relation(fields: [glossaryId], references: [id], onDelete: Cascade)
  term           String
  translations   Json
  definition     String?
  notes          String?
  caseSensitive  Boolean  @default(false)
  doNotTranslate Boolean  @default(false)
  keepUppercase  Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model ApiConfiguration {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        ApiProvider
  apiKeyEncrypted String
  model           String?
  endpoint        String?
  lastUsed        DateTime?
  createdAt       DateTime @default(now())

  @@unique([userId, provider])
}

enum ApiProvider {
  OPENAI
  AZURE
  DEEPL
  MODERNMT
  GOOGLE
}

model CreditTransaction {
  id                    String            @id @default(cuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id])
  type                  TransactionType
  amount                Int
  description           String?
  relatedProjectId      String?
  relatedProject        Project?          @relation(fields: [relatedProjectId], references: [id])
  stripePaymentIntentId String?
  breakdownJSON         Json?
  createdAt             DateTime          @default(now())
}

enum TransactionType {
  PURCHASE
  USAGE
  REFUND
  BONUS
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json             @default("{}")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum NotificationType {
  PREFERRED_JOB
  NEW_JOB
  DEADLINE_REMINDER
  PAYMENT
  SYSTEM
}

model RoutingLog {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  action    String
  details   Json     @default("{}")
  createdAt DateTime @default(now())
}

model OrganizationJoinRequest {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         JoinRequestStatus @default(PENDING)
  message        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([userId, organizationId])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model LinguistReview {
  id          String   @id @default(cuid())
  jobId       String   @unique
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  linguistId  String
  linguist    User     @relation("ReviewsReceived", fields: [linguistId], references: [id])
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
}

model LinguistBlacklist {
  id             String       @id @default(cuid())
  customerId     String
  customer       User         @relation("BlacklistOwner", fields: [customerId], references: [id])
  linguistId     String
  linguist       User         @relation("Blacklisted", fields: [linguistId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  reason         String?
  createdAt      DateTime     @default(now())

  @@unique([customerId, linguistId])
}

model Department {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  members        DepartmentMember[]
  invitations    DepartmentInvitation[]
}

model DepartmentMember {
  id               String     @id @default(cuid())
  departmentId     String
  department       Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String     @default("MEMBER")
  canAccessTM      Boolean    @default(false)
  canAccessGlossary Boolean   @default(false)
  requiresApproval Boolean    @default(true)
  joinedAt         DateTime   @default(now())

  @@unique([departmentId, userId])
}

model DepartmentInvitation {
  id               String           @id @default(cuid())
  departmentId     String
  department       Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById      String
  invitedBy        User             @relation("InvitesSent", fields: [invitedById], references: [id])
  email            String
  token            String           @unique @default(cuid())
  role             String           @default("MEMBER")
  canAccessTM      Boolean          @default(false)
  canAccessGlossary Boolean         @default(false)
  requiresApproval Boolean          @default(true)
  status           InvitationStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  expiresAt        DateTime

  @@unique([departmentId, email])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model SiteConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model PlanConfig {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  price           Decimal  @db.Decimal(10, 2)
  period          String   @default("/mo")
  description     String?
  features        String[]
  creditsPerCycle Int      @default(0)
  isPopular       Boolean  @default(false)
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  ctaText         String   @default("Get Started")
  ctaHref         String   @default("/register")
  stripePriceId   String?
  limitsJson      Json?
  nameAr          String?
  descriptionAr   String?
  featuresAr      String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PlanFeature {
  id        String   @id @default(cuid())
  feature   String
  planSlug  String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([feature, planSlug])
}

model ChangeLog {
  id          String   @id @default(cuid())
  adminId     String
  adminEmail  String?
  entityType  String
  entityKey   String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())
}

model CreditPackage {
  id           String   @id @default(cuid())
  name         String
  credits      Int
  bonusCredits Int      @default(0)
  priceUsd     Decimal  @db.Decimal(10, 2)
  isPopular    Boolean  @default(false)
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CreditRate {
  id             String   @id @default(cuid())
  workflowType   String   @unique
  creditsPerWord Decimal  @db.Decimal(10, 4)
  label          String
  description    String?
  updatedAt      DateTime @updatedAt
}

model PageMeta {
  pageKey       String
  locale        String   @default("en")
  title         String?
  description   String?
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  canonical     String?
  noIndex       Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@id([pageKey, locale])
}

enum LinguistType {
  SYSTEM
  INTERNAL
}

enum LinguistSource {
  SYSTEM_POOL
  PREFERRED
  INTERNAL
}

model LanguagePair {
  id         String   @id @default(cuid())
  sourceLang String
  targetLang String
  linguistProfiles LinguistLanguagePair[]

  @@unique([sourceLang, targetLang])
}

model LinguistLanguagePair {
  id                String          @id @default(cuid())
  linguistProfileId String
  linguistProfile   LinguistProfile @relation(fields: [linguistProfileId], references: [id], onDelete: Cascade)
  languagePairId    String
  languagePair      LanguagePair    @relation(fields: [languagePairId], references: [id], onDelete: Cascade)

  @@unique([linguistProfileId, languagePairId])
}

model LinguistRate {
  id             String   @id @default(cuid())
  workflowType   String   @unique
  ratePerWord    Decimal  @db.Decimal(10, 5)
  businessCutPct Decimal  @db.Decimal(5, 2) @default(10)
  label          String
  description    String?
  updatedAt      DateTime @updatedAt
}

model LinguistInvitation {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById      String
  invitedBy        User             @relation("LinguistInvitesSent", fields: [invitedById], references: [id])
  email            String
  token            String           @unique @default(cuid())
  languagePairs    Json             @default("[]")
  status           InvitationStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  acceptedBy       User?            @relation("LinguistInvitesAccepted", fields: [acceptedByUserId], references: [id])
}

// ─── Contentful Integration ─────────────────────────────────────────────────

model ContentfulConnection {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  spaceId         String
